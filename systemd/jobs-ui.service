[Unit]
Description=Jobs database explorer UI
After=network-online.target jobs.service
Wants=network-online.target jobs.service

[Service]
Type=simple
WorkingDirectory=/home/clanker/projects/nice/ui
Environment=PATH=/home/clanker/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/clanker/.nvm/versions/node/v24.19.0/bin/npm run preview -- --host 10.8.0.4 --port 4000
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
