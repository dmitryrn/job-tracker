[server]
http_address = ":8080"

[database]
path = "jobs.db"

[llm]
base_url = "https://opencode.ai/zen/go/v1/chat/completions"

[llm.job_analysis]
model = "glm-5.2"
reasoning_effort = "low"

[llm.profile_matcher]
model = "glm-5.2"
reasoning_effort = "low"

[llm.job_chat]
model = "openai/gpt-5.6-terra"
reasoning_effort = "high"

[job_match]
run_interval = "2m"

[events]
queue_size = 1000
batch_size = 100
flush_interval = "1s"

[providers.adzuna]
sync_interval = "6h"

[providers.remotive]
sync_interval = "6h"

[providers.jobicy]
sync_interval = "6h"

[providers.linkedin]
sync_interval = "6h"
request_interval = "30s"
