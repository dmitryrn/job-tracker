[server]
http_address = ":8080"
metrics_socket_path = "observability/metrics/jobs-metrics.sock"

[database]
path = "jobs.db"

[opencode]
base_url = "https://opencode.ai/zen/go/v1/chat/completions"

[openai]
base_url = "http://127.0.0.1:8080/v1/chat/completions"

[job_analysis]
provider = "opencode"
model = "glm-5.2"
reasoning_effort = "high"

[profile_matcher]
provider = "opencode"
model = "glm-5.2"
reasoning_effort = "high"

[job_chat]
provider = "openai"
model = "gpt-5.6-terra"
reasoning_effort = "high"

[job_match]
run_interval = "2m"

[events]
queue_size = 1000
batch_size = 100
flush_interval = "1s"

[providers.adzuna]
sync_interval = "6h"

[providers.remotive]
sync_interval = "6h"

[providers.jobicy]
sync_interval = "6h"

[providers.linkedin]
sync_interval = "6h"
request_interval = "30s"
preview_request_interval = "5s"
