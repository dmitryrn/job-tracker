[server]
http_address = ":8080"

[database]
path = "jobs.db"

[providers.adzuna]
query = "software engineer"
country = "de"
max_days_old = 30
max_pages = 5
results_per_page = 50
workplace = "remote-hybrid"
sync_interval = "6h"

[providers.remotive]
query = "software engineer"
sync_interval = "6h"

[providers.jobicy]
count = 50
geo = "europe"
industry = "engineering"
tag = ""
sync_interval = "6h"
